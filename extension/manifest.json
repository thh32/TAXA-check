{
  "manifest_version": 3,
  "name": "TAXA-check",
  "version": "2.3.0",
  "description": "Highlights prokaryotic names and summarizes LPSN and SeqCode histories.",
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": [
    "<all_urls>",
    "https://raw.githubusercontent.com/thh32/TAXA-check/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file://*/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["generated/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
